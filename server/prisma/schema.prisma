generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  role     String  @default("affiliate")
  isActive Boolean @default(true)

  trackingLinks TrackingLink[]
  clicks        Click[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offer {
  id             String  @id @default(cuid())
  title          String
  category       String
  description    String?
  landingPageUrl String
  payout         Float
  status         String  @default("active")

  trackingLinks TrackingLink[]
  clicks        Click[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrackingLink {
  id   String @id @default(cuid())
  slug String @unique

  affiliateId String
  affiliate   User   @relation(fields: [affiliateId], references: [id])

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id])

  clicks Click[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Click {
  id             String       @id @default(cuid())
  trackingLinkId String
  trackingLink   TrackingLink @relation(fields: [trackingLinkId], references: [id])

  clickId String @unique

  affiliateId String
  affiliate   User   @relation(fields: [affiliateId], references: [id])

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id])

  ip      String?
  country String?
  city    String?

  device  String  @default("desktop")
  browser String?
  os      String?

  referer String?

  isConverted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingLinkId, createdAt])
  @@index([clickId])
}
