generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id   String @id @default(cuid())
  companyName String
  slug String @unique

  users         User[]
  offers        Offer[]
  trackingLinks TrackingLink[]
  clicks        Click[]
  conversions   Conversion[]
  payouts       Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  role     String  @default("affiliate")
  isActive Boolean @default(true)
  tenantId String

  trackingLinks TrackingLink[]
  clicks        Click[]
  conversions   Conversion[]
  payouts       Payout[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offer {
  id             String  @id @default(cuid())
  title          String
  category       String
  description    String?
  landingPageUrl String
  payout         Float
  status         String  @default("active")
  tenantId       String

  trackingLinks TrackingLink[]
  clicks        Click[]
  conversions   Conversion[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrackingLink {
  id   String @id @default(cuid())
  slug String @unique

  affiliateId String
  affiliate   User   @relation(fields: [affiliateId], references: [id])

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clicks      Click[]
  conversions Conversion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Click {
  id             String       @id @default(cuid())
  trackingLinkId String
  trackingLink   TrackingLink @relation(fields: [trackingLinkId], references: [id])

  clickId String @unique

  affiliateId String
  affiliate   User   @relation(fields: [affiliateId], references: [id])

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  ip      String?
  country String?
  city    String?

  device  String  @default("desktop")
  browser String?
  os      String?

  referer String?

  isConverted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversions Conversion?

  @@index([trackingLinkId, createdAt])
  @@index([clickId])
}

model Conversion {
  id             String @id @default(cuid())
  clickId        String @unique
  trackingLinkId String
  offerId        String
  affiliateId    String
  tenantId       String

  revenue Float
  payout  Float

  status       String @default("approved")
  payoutStatus String @default("pending")

  payoutId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  click        Click        @relation(fields: [clickId], references: [id])
  trackingLink TrackingLink @relation(fields: [trackingLinkId], references: [id])
  offer        Offer        @relation(fields: [offerId], references: [id])
  affiliate    User         @relation(fields: [affiliateId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  payoutRecord Payout? @relation(fields: [payoutId], references: [id])

  @@index([offerId, createdAt])
}

model Payout {
  id String @id @default(cuid())

  affiliateId String
  tenantId    String
  amount      Float

  status String    @default("pending")
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliate User   @relation(fields: [affiliateId], references: [id])
  tenant    Tenant @relation(fields: [tenantId], references: [id])

  conversions Conversion[]
}
